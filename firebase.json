{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "redirects": [
      { "source": "/healthcare", "destination": "/industries/healthcare", "type": 301 },
      { "source": "/sales-roleplay", "destination": "/industries/sales-training", "type": 301 },
      { "source": "/pharma", "destination": "/industries/medtech", "type": 301 },
      { "source": "/insurance", "destination": "/industries/banking", "type": 301 }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.storyblok.com; connect-src 'self' https://api.storyblok.com https://a.storyblok.com; frame-ancestors 'self' https://app.storyblok.com" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|gif|webp|ico|webm)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}
